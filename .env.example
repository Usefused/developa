# Local development only. Replace both occurrences before using shared infrastructure.
POSTGRES_USER=developa
POSTGRES_DB=developa
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://developa:change-me-local-only@postgres:5432/developa?sslmode=disable
HTTP_PORT=8080
# Public prebuilt image. `docker compose up --build` still builds from this checkout.
DEVELOPA_IMAGE=ghcr.io/usefused/developa:latest
# Optional OTLP HTTP collector base URL. Empty exports safe spans to stderr.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Required when connecting a repository. Generate a random token of at least 24 characters.
DEVELOPA_API_TOKEN=
REPOSITORY_NAME=
# Native server path, or an existing container path if using custom mounts.
REPOSITORY_PATH=
# Multiple checkouts instead of REPOSITORY_PATH (paths as seen by the server).
# REPOSITORIES='[{"name":"API","path":"/repositories/api"},{"name":"Worker","path":"/repositories/worker"}]'
REPOSITORIES=
# Allowed server filesystem folders for the Add workspace picker (JSON array).
# Docker: mount these folders read-only and use their container paths.
# Empty defaults to explicitly configured checkout roots, not their parent folders.
WORKSPACE_ROOTS=
# For the optional compose.repository.yaml read-only bind mount.
REPOSITORY_HOST_PATH=
WATCH_INTERVAL=2s
SCAN_TIMEOUT=30s
# Shared fallback model. Inference is disabled when both task roles are unset.
OLLAMA_MODEL=
# Optional per-task overrides; empty uses OLLAMA_MODEL. Use a smaller analysis model
# and a separate question-answering model to control latency and provider quota.
OLLAMA_ANALYSIS_MODEL=
OLLAMA_ANSWER_MODEL=
# Cloud is explicit opt-in: selected source excerpts and questions leave this server.
OLLAMA_CLOUD=false
# Inject from your environment or secret manager. Never commit a real key.
OLLAMA_API_KEY=
# Cloud requires https://ollama.com. Native local default is http://127.0.0.1:11434.
# For Docker-to-host local access, set http://host.docker.internal:11434.
OLLAMA_URL=
# Alias accepting the common https://ollama.com/v1/ form; do not set conflicting URLs.
OLLAMA_BASE_URL=
OLLAMA_TIMEOUT=60s
AI_TIMEOUT=120s
# Enable durable, explicitly requested Features jobs. Working-tree indexing uses no AI.
# Disable to pause all jobs while retaining answer/context APIs.
AI_INDEX_ENABLED=true
# Broad discovery is explicit by default. Opt in to automatic clean-commit jobs.
AI_AUTO_FEATURES=false
AI_POLL_INTERVAL=2s
