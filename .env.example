# Denverr connects to an operator-managed PostgreSQL database.
DATABASE_URL=postgres://denverr:change-me@127.0.0.1:5432/denverr?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
# Optional OTLP HTTP collector base URL. Empty exports safe spans to stderr.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Standard OpenTelemetry kill switch. True creates no spans and exports nothing.
OTEL_SDK_DISABLED=false

# Optional. When empty, Denverr creates a private token in the user config directory.
DENVERR_API_TOKEN=
REPOSITORY_NAME=
REPOSITORY_PATH=
# Multiple checkouts instead of REPOSITORY_PATH.
# REPOSITORIES='[{"name":"API","path":"/Users/me/code/api"}]'
REPOSITORIES=
# Allowed filesystem folders for the Add workspace picker (JSON array).
# `denverr serve` defaults this to its current directory when no workspace is configured.
WORKSPACE_ROOTS=
WATCH_INTERVAL=2s
SCAN_TIMEOUT=30s
# Byte budgets apply to Go source and module files, not unrelated repository assets.
SOURCE_MAX_FILE_BYTES=4194304
SOURCE_MAX_TOTAL_BYTES=67108864
# Shared fallback model. Inference is disabled when every purpose model is unset.
OLLAMA_MODEL=
# Optional per-task overrides. FEATURE and REVIEW fall back through the legacy
# ANALYSIS role; ANSWER falls back directly to OLLAMA_MODEL.
OLLAMA_ANALYSIS_MODEL=
OLLAMA_FEATURE_MODEL=
OLLAMA_REVIEW_MODEL=
OLLAMA_ANSWER_MODEL=
# Cloud is explicit opt-in: selected source excerpts and questions leave this server.
OLLAMA_CLOUD=false
# Inject from your environment or secret manager. Never commit a real key.
OLLAMA_API_KEY=
# Cloud requires https://ollama.com. Native local default is http://127.0.0.1:11434.
OLLAMA_URL=
# Alias accepting the common https://ollama.com/v1/ form; do not set conflicting URLs.
OLLAMA_BASE_URL=
OLLAMA_TIMEOUT=60s
AI_TIMEOUT=120s
# Enable durable, explicitly requested Features jobs. Working-tree indexing uses no AI.
# Disable to pause all jobs while retaining answer/context APIs.
AI_INDEX_ENABLED=true
# Broad discovery is explicit by default. Opt in to automatic clean-commit jobs.
AI_AUTO_FEATURES=false
AI_POLL_INTERVAL=2s
